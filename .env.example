# ── Aplicação ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Proxies confiáveis à frente da API (nº de hops, ex.: 1 atrás de um load balancer).
# Vazio/false = desligado. Necessário em produção para o rate limit usar o IP real do cliente.
# TRUST_PROXY=1
# Swagger (/docs) fica desligado em produção; true força habilitar.
# SWAGGER_ENABLED=false
# Fuso IANA que define "hoje" nas regras de data (faturas, vencimentos, pagamentos).
# Independe do TZ do processo/servidor. Padrão: America/Sao_Paulo. Fuso inválido impede o boot.
# APP_TIMEZONE=America/Sao_Paulo

# ── Banco de Dados (PostgreSQL) ───────────────────────────────
# Caracteres especiais da senha precisam de URL-encoding na URL (@ → %40).
DATABASE_URL=postgresql://fintrack:test%40123@localhost:5432/fintrack_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fintrack
DB_PASSWORD=test@123
DB_NAME=fintrack_db
# Em produção DB_PASSWORD (ou DATABASE_URL) é obrigatório — a API não sobe sem.
# TLS: DB_SSL default true em produção e false fora dela.
# DB_SSL=true
# CA do servidor (PEM); aceita quebras de linha escapadas como \n.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nSUA_CA_AQUI\n-----END CERTIFICATE-----\n"
# Default true. false desativa a validação do certificado — use só se o provedor
# não fornecer a CA, ciente do risco de MITM.
# DB_SSL_REJECT_UNAUTHORIZED=true
# true loga todas as queries com parâmetros (só dev). Padrão: apenas erros e avisos.
# DB_LOGGING=false
# Timeouts do pool (ms): espera por conexão nova e duração máxima de cada query.
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000

# ── Redis (cache, BullMQ, throttler) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Mesmo valor usado pelo docker-compose (default de dev: fintrack_redis_dev).
# Vazio = sem autenticação (ex.: CI).
REDIS_PASSWORD=fintrack_redis_dev
# true para conexão TLS (Redis gerenciado).
# REDIS_TLS=false

# ── Firebase Admin SDK ────────────────────────────────────────
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_API_KEY=sua-web-api-key


# ── WhatsApp (Meta Cloud API) ─────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
