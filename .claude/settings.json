{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run migration:show)",
      "Bash(make test:*)",
      "Bash(make lint)",
      "Bash(make validate-env)",
      "Bash(make validate-setup)",
      "Bash(npx jest:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-ts.sh", "timeout": 60 }]
      }
    ]
  }
}
